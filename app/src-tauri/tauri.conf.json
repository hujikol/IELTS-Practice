{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IELTS Studio",
  "version": "0.1.0",
  "identifier": "local.ielts.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "IELTS Studio",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Education",
    "shortDescription": "Offline IELTS practice",
    "longDescription": "Offline-first IELTS Academic practice with copy/paste material generation."
  }
}
